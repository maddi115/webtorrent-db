# Copy this file to .env.local to change network settings

# Your own bootstrap relays, separated by commas
# VITE_BOOTSTRAP_RELAYS=ws://localhost:7777

# TURN is off until you add your TURN worker's address (see tools/turn-worker)
# VITE_TURN_ENDPOINT=https://webtorrent-turn.YOUR-NAME.workers.dev

# Or use a fixed TURN server instead
# VITE_TURN_URLS=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
